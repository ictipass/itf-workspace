// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OfficeType {
  HEADQUARTERS
  ZONAL_OFFICE
  CORPORATE_OFFICE
  SKILLS_CENTRE
  AREA_OFFICE
  STAFF_SCHOOL
}

enum WorkspaceRole {
  STAFF
  APP_ADMIN
  SYSTEM_ADMIN
}

enum AppStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AppEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

enum AppCategory {
  WORKFLOW
  TRAINING
  FINANCE
  HR
  PROCUREMENT
  COMPLIANCE
  REPORTING
  ADMINISTRATION
  OTHER
}

enum AppAccessStatus {
  ACTIVE
  REVOKED
  PENDING
}

enum AssuranceRequirement {
  STANDARD
  SENSITIVE
}

enum AuditAction {
  LOGIN
  LOGOUT
  APP_OPENED
  APP_CREATED
  APP_UPDATED
  ACCESS_GRANTED
  ACCESS_REVOKED
  USER_CREATED
  USER_UPDATED
  SESSION_TERMINATED
  MFA_ENROLLED
  MFA_VERIFIED
  MFA_RECOVERY_CODES_REGENERATED
  MFA_REPLACEMENT_STARTED
  MFA_REPLACED
  MFA_RECOVERY_AUTHORITY_GRANTED
  MFA_RECOVERY_AUTHORITY_REVOKED
  MFA_RECOVERY_REQUEST_CREATED
  MFA_RECOVERY_REQUEST_APPROVED
  MFA_RECOVERY_REQUEST_REJECTED
  MFA_RECOVERY_COMPLETED
  SECURITY_NOTIFICATION_SENT
  SECURITY_NOTIFICATION_FAILED
  APP_ROLE_POLICY_CREATED
  APP_ROLE_POLICY_UPDATED
}

enum WorkspaceSessionRevocationReason {
  USER_SIGN_OUT
  USER_TERMINATED
  ADMIN_TERMINATED
  PASSWORD_CHANGED
  ACCOUNT_DEACTIVATED
  IDLE_TIMEOUT
  ABSOLUTE_TIMEOUT
  SESSION_LIMIT_RECOVERY
  MFA_REPLACED
  MFA_RECOVERY
}

enum MfaRecoveryAuthorityRole {
  HR_IDENTITY_VERIFIER
  ICT_SECURITY_APPROVER
  ICT_RECOVERY_OPERATOR
}

enum MfaRecoveryRequestStatus {
  PENDING_SECURITY_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

enum IntegrationOutboxEventType {
  CENTRAL_LOGOUT
  ENTITLEMENT_REVOKED
}

enum IntegrationOutboxStatus {
  PENDING
  PROCESSING
  RETRY
  DELIVERED
  DEAD_LETTER
}

model User {
  id                  String  @id @default(cuid())
  staffNumber         String? @unique
  fullName            String
  email               String  @unique
  passwordHash        String?
  isTemporaryPassword Boolean @default(true)

  workspaceRole WorkspaceRole @default(STAFF)
  status        UserStatus    @default(ACTIVE)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  supervisorId  String?
  supervisor    User?   @relation("WorkspaceReportingLine", fields: [supervisorId], references: [id], onDelete: SetNull)
  directReports User[]  @relation("WorkspaceReportingLine")

  appAccesses           AppAccess[]
  auditLogs             AuditLog[]
  workspaceSessions     WorkspaceSession[]
  sessionRecoveryGrants WorkspaceSessionRecoveryGrant[]
  mfaRecoveryCodes      MfaRecoveryCode[]
  mfaRecoveryAuthority  MfaRecoveryAuthority? @relation("MfaRecoveryAuthoritySubject")
  mfaAuthorityGrants    MfaRecoveryAuthority[] @relation("MfaRecoveryAuthorityGrantor")
  mfaRecoveryTargets    MfaRecoveryRequest[]   @relation("MfaRecoveryTarget")
  mfaIdentityChecks     MfaRecoveryRequest[]   @relation("MfaRecoveryIdentityVerifier")
  mfaSecurityApprovals  MfaRecoveryRequest[]   @relation("MfaRecoverySecurityApprover")
  mfaRecoveryExecutions MfaRecoveryRequest[]   @relation("MfaRecoveryExecutor")

  totpSecretCiphertext        String?
  totpEnrolledAt              DateTime?
  totpPendingSecretCiphertext String?
  totpPendingExpiresAt        DateTime?
  totpLastUsedCounter         BigInt?
  mfaEnrollmentRequired       Boolean   @default(false)
  mfaRecoveryFailedAttempts   Int       @default(0)
  mfaRecoveryLockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supervisorId, status])
}

model MfaRecoveryCode {
  id       String @id @default(cuid())
  codeHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, consumedAt])
}

model MfaRecoveryAuthority {
  id   String                   @id @default(cuid())
  role MfaRecoveryAuthorityRole

  userId String @unique
  user   User   @relation("MfaRecoveryAuthoritySubject", fields: [userId], references: [id], onDelete: Cascade)

  grantedById String
  grantedBy   User   @relation("MfaRecoveryAuthorityGrantor", fields: [grantedById], references: [id])

  approvalReference String
  grantedAt         DateTime  @default(now())
  revokedAt         DateTime?

  @@index([role, revokedAt])
}

model MfaRecoveryRequest {
  id     String                   @id @default(cuid())
  status MfaRecoveryRequestStatus

  targetUserId String
  targetUser   User   @relation("MfaRecoveryTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  identityVerifiedById String
  identityVerifiedBy   User   @relation("MfaRecoveryIdentityVerifier", fields: [identityVerifiedById], references: [id])
  identityVerificationReference String
  identityVerifiedAt            DateTime @default(now())

  securityApprovedById String?
  securityApprovedBy   User?    @relation("MfaRecoverySecurityApprover", fields: [securityApprovedById], references: [id])
  securityApprovalReference String?
  securityApprovedAt        DateTime?

  executedById String?
  executedBy   User?    @relation("MfaRecoveryExecutor", fields: [executedById], references: [id])
  executedAt   DateTime?

  rejectionReason String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetUserId, status])
  @@index([status, expiresAt])
}

model WorkspaceSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authenticatedAt   DateTime @default(now())
  lastActivityAt    DateTime @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime

  mfaAuthenticatedAt    DateTime?
  authenticationMethods String[]  @default(["pwd"])

  revokedAt    DateTime?
  revokeReason WorkspaceSessionRevocationReason?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model WorkspaceSessionRecoveryGrant {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model IntegrationOutboxEvent {
  id      String @id @default(cuid())
  eventId String @unique @default(uuid())

  targetAppSlug      String
  type               IntegrationOutboxEventType
  workspaceUserId    String
  workspaceSessionId String?
  reason             String

  status         IntegrationOutboxStatus @default(PENDING)
  attemptCount   Int                     @default(0)
  availableAt    DateTime                @default(now())
  leaseId        String?
  leaseExpiresAt DateTime?
  deliveredAt    DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetAppSlug, status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([workspaceUserId, createdAt])
}

model Office {
  id       String     @id @default(cuid())
  name     String
  code     String     @unique
  type     OfficeType
  isActive Boolean    @default(true)

  users       User[]
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id       String  @id @default(cuid())
  name     String
  code     String
  isActive Boolean @default(true)

  officeId String?
  office   Office? @relation(fields: [officeId], references: [id])

  users     User[]
  divisions Division[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, officeId])
}

model Division {
  id       String  @id @default(cuid())
  name     String
  code     String
  isActive Boolean @default(true)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  users User[]
  units Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, departmentId])
}

model Unit {
  id       String  @id @default(cuid())
  name     String
  code     String
  isActive Boolean @default(true)

  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id       String  @id @default(cuid())
  title    String
  code     String  @unique
  isActive Boolean @default(true)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model App {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  url         String
  icon        String?

  category    AppCategory
  environment AppEnvironment @default(PRODUCTION)
  status      AppStatus      @default(ACTIVE)

  assuranceRequirement AssuranceRequirement @default(STANDARD)
  launchAudience       String               @unique

  accessRules  AppAccess[]
  rolePolicies AppRolePolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppAccess {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  appRole String
  status  AppAccessStatus @default(ACTIVE)

  grantedById String?
  grantedAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@unique([userId, appId])
  @@index([userId])
  @@index([appId])
}

model AppRolePolicy {
  id String @id @default(cuid())

  appId String
  app   App    @relation(fields: [appId], references: [id], onDelete: Cascade)

  roleCode             String
  assuranceRequirement AssuranceRequirement @default(STANDARD)
  isActive             Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, roleCode])
  @@index([appId, isActive])
}

model AuditLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  action   AuditAction
  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
}
