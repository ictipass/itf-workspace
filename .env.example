DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itf_workspace_db"
# Organizational deployment stage; do not use NODE_ENV to distinguish Vercel Preview from Production.
WORKSPACE_DEPLOYMENT_STAGE="development"
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Exact extra host[:port] values for approved reverse proxies or development tunnels. No schemes or wildcards.
WORKSPACE_SERVER_ACTION_ALLOWED_ORIGINS=""
INITIAL_ADMIN_EMAIL="ict.admin@itf.gov.ng"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-temporary-password"
INITIAL_ADMIN_NAME="ICT System Administrator"
INITIAL_ADMIN_STAFF_NUMBER="ITF-SYS-001"
RESEND_API_KEY="replace-with-a-resend-api-key"
RESEND_FROM_EMAIL="ITF Workspace <workspace@example.gov.ng>"
APP_LOGIN_URL="http://localhost:3000/login"
ITF_FLOW_URL="http://localhost:3001/workspace/launch"
ITF_FLOW_DIRECTORY_SYNC_URL="http://localhost:3001/api/integrations/workspace/directory-sync"
ITF_FLOW_SESSION_EVENTS_URL="http://localhost:3001/api/integrations/workspace/session-events"
ITF_FLOW_APP_SLUG="itf-flow"
WORKSPACE_LAUNCH_ISSUER="http://localhost:3000"
WORKSPACE_LAUNCH_SIGNER_PROVIDER="ephemeral"
WORKSPACE_LAUNCH_ACTIVE_KID="development-key-id"
# Software keys are development/staging only. Supply a base64-encoded PKCS#8 PEM when provider=software.
WORKSPACE_LAUNCH_PRIVATE_KEY_PEM_BASE64=""
# Production provider=kms requires the approved non-exportable provider key identifier.
WORKSPACE_LAUNCH_KMS_KEY_ID=""
WORKSPACE_LAUNCH_ADDITIONAL_PUBLIC_JWKS_JSON='{"keys":[]}'
WORKSPACE_LAUNCH_TTL_SECONDS="120"
WORKSPACE_LAUNCH_CLOCK_SKEW_SECONDS="30"
WORKSPACE_MFA_STEP_UP_SECONDS="600"
# Generate 32 random bytes and store only their base64 value in the deployment secret manager.
WORKSPACE_MFA_ENCRYPTION_KEY_BASE64=""
WORKSPACE_DIRECTORY_SYNC_SECRET="replace-with-the-itf-flow-directory-sync-secret"
WORKSPACE_DIRECTORY_SYNC_BATCH_SIZE="200"
WORKSPACE_DIRECTORY_SYNC_TIMEOUT_MS="30000"
WORKSPACE_INTEROP_SECRET="replace-with-a-separate-itf-flow-session-event-secret"
# Protects the retry-worker endpoint; do not reuse an application interoperability secret.
WORKSPACE_OUTBOX_WORKER_SECRET="replace-with-a-separate-outbox-worker-secret"
WORKSPACE_OUTBOX_REQUEST_TIMEOUT_MS="3000"
WORKSPACE_OUTBOX_BATCH_SIZE="20"
WORKSPACE_OUTBOX_MAX_ATTEMPTS="10"
WORKSPACE_OUTBOX_RETRY_BASE_SECONDS="30"
WORKSPACE_OUTBOX_RETRY_MAX_SECONDS="3600"
WORKSPACE_OUTBOX_LEASE_SECONDS="30"
WORKSPACE_STAFF_IDLE_TIMEOUT_SECONDS="1200"
WORKSPACE_PRIVILEGED_IDLE_TIMEOUT_SECONDS="600"
WORKSPACE_SESSION_WARNING_SECONDS="120"
WORKSPACE_ABSOLUTE_TIMEOUT_SECONDS="10800"
WORKSPACE_MAX_CONCURRENT_SESSIONS="2"
WORKSPACE_SESSION_RECOVERY_TTL_SECONDS="300"
