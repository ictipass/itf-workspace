{
  "name": "itf-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "config:check": "tsx scripts/validate-environment.ts",
    "config:check:production": "tsx scripts/validate-environment.ts --environment=production",
    "test": "npm run test:security",
    "test:security": "tsx --test tests/security-regression.test.ts tests/configuration-regression.test.ts tests/session-regression.test.ts",
    "verify": "npm run config:check && prisma validate && npm run test:security && npm run lint && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.11.0",
    "recharts": "^3.8.0",
    "resend": "6.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "7.9.1",
    "shadcn": "4.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
